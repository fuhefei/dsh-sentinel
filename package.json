{
  "name": "dsh-sentinel",
  "version": "0.12.1",
  "license": "BSD-3-Clause",
  "description": "DSH 哨兵：条件驱动的 agent 唤醒系统——文件/进程/端口/命令传感器，订阅存为会话事件，重启自动复活；每个订阅、每次触发对用户完全可见",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "docs",
    "patches"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-scope": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.25.0",
    "react": "^18.2.0",
    "tsdown": "0.22.0",
    "typescript": "^5.5.0",
    "unrun": "^0.3.1",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "bundle": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
